	column 'Order Date' =
			
			VAR TimestampValue = 'public orders_clean'[order_timestamp]
			RETURN
			    IF(
			        ISBLANK(TimestampValue),
			        BLANK(),
			        DATE(
			            YEAR(TimestampValue),
			            MONTH(TimestampValue),
			            DAY(TimestampValue)
			        )
